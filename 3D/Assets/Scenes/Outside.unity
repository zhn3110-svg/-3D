  m_text: "2026-2\n\uAC8C\uC784 \uCE90\uB9AD\uD130 \uC77C\uB7EC\uC2A4\uD2B8\uC785\uB2C8\uB2E4.\n\n[\uCEE8\uC149]\n\uB3C5
